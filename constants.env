# Shared constants for GitHub workflows and repository automation.

# Rust toolchain versions

# used for testing, ensures the MSRV promise is kept; must match Cargo.toml [package].rust-version
RUST_MSRV=1.90.0
# used for static analysis & mutation testing; must match rust-toolchain.toml
RUST_LATEST=1.96.0
# used for coverage and extended analysis; update on a regular basis
# Pinned to 2026-06-05: newer nightlies (regression landed 2026-06-07) ICE under
# Miri with "layout mismatch for result of PtrMetadata" when reconstructing an
# Rc/Arc of a `dyn Trait`-tailed DST via `from_raw`. Bump once that is fixed upstream.
RUST_NIGHTLY=nightly-2026-06-05

# Cargo tools
CARGO_CAREFUL_VERSION=0.4.10
CARGO_DENY_VERSION=0.19.9
CARGO_ENSURE_NO_DEFAULT_FEATURES_VERSION=1.1.0
CARGO_LLVM_COV_VERSION=0.8.7
CARGO_MUTANTS_VERSION=27.1.0
CARGO_NEXTEST_VERSION=0.9.138
CARGO_SORT_VERSION=2.1.4
CARGO_SPELLCHECK_VERSION=0.15.7
CARGO_RDME_VERSION=2.1.0
CARGO_UDEPS_VERSION=0.1.61

# Other tools
SCCACHE_VERSION=v0.16.0
